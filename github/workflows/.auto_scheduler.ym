# اسم الملف المطلوب وضعه في الأعلى: .github/workflows/auto_scheduler.yml

name: Auto Video Trend Scheduler

on:
  schedule:
    - cron: '34 6 * * *'
    - cron: '34 12 * * *'
    - cron: '34 18 * * *'
  workflow_dispatch:

jobs:
  run-trend-agent:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          pip install requests supabase

      - name: Execute Trend Agent
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
        run: python trend_agent.py
